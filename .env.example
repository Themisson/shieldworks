# No environment variable is required to render the site locally.
# Canonical host and professional profiles are maintained in src/lib/seo.ts and src/data/site.ts.
# Vercel Analytics uses the existing integration; no custom analytics key is required.
# Contact AND feedback require all three server-only values below to send real email.
# Leave empty for local evaluation. Tests mock the provider; never add credentials to Docker images.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Future newsletter/CMS/storage integrations are not implemented and need no credentials.

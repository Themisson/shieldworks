{
  "name": "shieldworks",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check": "npm run lint && npm run test && npm run check:i18n && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "check:content": "vitest run src/lib/__tests__/editorial.test.ts",
    "typecheck": "tsc --noEmit",
    "inspect:local": "node scripts/inspect-local.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "katex": "0.19.1",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
